# Variables du serveur contrôleur (.env à côté de compose.yaml). Aucun secret ici.
FOREMAN_DOMAIN=foreman.example.com
FOREMAN_LOG_LEVEL=INFO
FOREMAN_DATABASE_URL=postgresql+psycopg://foreman:CHANGE_ME@db:5432/foreman

# --- Serveur avec Traefik existant (deploy-custom.sh) : à mettre dans /opt/<projet>/.env ---
# Traefik (valeurs par défaut ci-dessous ; à ajuster à votre installation)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT_HTTP=web
TRAEFIK_ENTRYPOINT_HTTPS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Authentification (#228). Cible : mode session, l'application authentifie elle-même ; Traefik n'ajoute aucun basicAuth.
FOREMAN_AUTH_MODE=session
FOREMAN_PUBLIC_URL=https://foreman.example.com
# Cookie Secure : ne jamais mettre FOREMAN_COOKIE_SECURE=0 ici (refusé par deploy-custom.sh).
# Sous-réseau du réseau Traefik (docker network inspect traefik) : seuls ses proxys sont crus pour X-Forwarded-For,
# sinon le rate-limit par IP voit l'IP de Traefik. Jamais « * ».
FORWARDED_ALLOW_IPS=172.18.0.0/16
# RETOUR ARRIÈRE (tant que le mode proxy_header existe, #225) : remplacer les lignes ci-dessus par
#   FOREMAN_AUTH_MODE=proxy_header
#   FOREMAN_DEV_MEMBERS=alice:developer
#   FOREMAN_BASIC_AUTH_USERS='admin:$apr1$CHANGE$ME'   # utilisateur:empreinte htpasswd, entre APOSTROPHES
# (empreinte : `printf "FOREMAN_BASIC_AUTH_USERS='admin:%s'\n" "$(openssl passwd -apr1 "$PW")"`, voir DEPLOYMENT.md)

# Limites de ressources par conteneur
APP_CPUS=1.0
APP_MEM_LIMIT=512M
APP_MEM_RESERVATION=128M
APP_PIDS_LIMIT=200
DB_CPUS=1.0
DB_MEM_LIMIT=512M
DB_MEM_RESERVATION=128M
DB_PIDS_LIMIT=200

# Journaux Docker (rotation)
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# PostgreSQL du projet (uniquement avec --with-db). Le mot de passe doit être le même
# que dans FOREMAN_DATABASE_URL ci-dessus, dont l'hôte doit être « db » (exigé par deploy-custom.sh --with-db). Aucune valeur réelle dans ce fichier d'exemple.
POSTGRES_USER=foreman
POSTGRES_DB=foreman
POSTGRES_PASSWORD=CHANGE_ME
