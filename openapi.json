                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Capacit\u00e9 atteinte"
          }
        },
        "summary": "Get Project"
      }
    },
    "/api/projects/{project_id}/events": {
      "get": {
        "operationId": "stream_events_api_projects__project_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Project Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "After",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "last-event-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Event",
                  "type": "string"
                }
              }
            },
            "description": "Flux SSE. `id:` = `seq`, pas de champ `event:`, `data:` = un `Event` JSON, commentaire `:` de maintien toutes les 15 s, `retry: 3000`. Rejoue les \u00e9v\u00e9nements de `seq > max(Last-Event-ID, after)`, dans l'ordre, puis le direct. Un `Last-Event-ID` non num\u00e9rique est ignor\u00e9. Si la reprise est plus ancienne que le plus vieil \u00e9v\u00e9nement conserv\u00e9, le serveur rejoue depuis celui-ci (le client d\u00e9tecte le trou par la rupture de contigu\u00eft\u00e9 de `seq` et repart de l'\u00e9tat re\u00e7u). Un abonn\u00e9 trop lent voit le flux ferm\u00e9 par le serveur et se reconnecte. Toute r\u00e9ponse non 200 est invisible pour `EventSource` : sur erreur avec `readyState` \u00e0 `CLOSED`, appeler `GET /projects/{id}` pour distinguer 404 et 503."
          },
          "404": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Introuvable"
          },
          "422": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Requ\u00eate invalide"
          },
          "501": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Pas encore impl\u00e9ment\u00e9"
          },
          "503": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Capacit\u00e9 atteinte"
          }
        },
        "summary": "Stream Events"
      }
    },
    "/api/projects/{project_id}/messages": {
      "post": {
        "description": "Un seul tour \u00e0 la fois par projet : un second message pendant un tour renvoie 409.",
        "operationId": "post_message_api_projects__project_id__messages_post",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Project Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Introuvable"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Un tour est d\u00e9j\u00e0 en cours pour ce projet (`turn_in_progress`)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Requ\u00eate invalide"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Pas encore impl\u00e9ment\u00e9"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Capacit\u00e9 atteinte"
          }
        },
        "summary": "Post Message"
      }
    },
